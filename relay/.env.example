# systemd 部署时复制到 /etc/hayagarden-browser-base.env；本地跑则 export 到 shell 里
# Browser Base 固定为 127.0.0.1:8271、CDP 127.0.0.1:9333，profile 固定为：
# /root/snap/chromium/common/hayagarden-browser-base-profile

# 手机登录密码。必须设强密码：登录没有防爆破，这就是唯一的一道门。
# 留空 = 无门禁，仅限本机调试。
BROWSER_RELAY_PASS=

# 可选：覆盖本机 Chromium 路径；生产默认固定为 /snap/bin/chromium。
#CHROME_BIN=/snap/bin/chromium

# 可选：固定 SOCKS5 出口；留空表示不配置代理，不自动切换或回退。
BROWSER_RELAY_PROXY_SERVER=

