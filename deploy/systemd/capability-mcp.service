[Unit]
Description=HayaGarden Capability MCP (resident UH-A0 capability proxy)
After=network.target
# Restarts with the gateway, so every deploy and rollback reloads this code.
PartOf=frontend-gw.service

[Service]
Type=simple
WorkingDirectory=/opt/frontend
EnvironmentFile=/opt/frontend/.env
ExecStart=/usr/bin/node /opt/frontend/capability-proxy-mcp-server.js
Environment=CAPABILITY_MCP_PORT=3102
Environment=UH_A0_REPO_ROOT=/opt/frontend
Environment=TODO_INTERNAL_DB_PATH=/opt/frontend/memories.db
Environment=HAYA_DB_PATH=/opt/frontend/memories.db
Environment=TASK_TIMER_COMMANDS_DB_PATH=/var/lib/hayagarden/commands.db
Environment=HAYAGARDEN_GALLERY_ROOT=/opt/frontend
Environment=HAYAGARDEN_ATTACHMENTS_ROOT=/opt/frontend
Environment=TZ=Asia/Shanghai
Environment=NODE_ENV=production
Restart=always
RestartSec=5
StandardOutput=append:/opt/frontend/capability-mcp.log
StandardError=append:/opt/frontend/capability-mcp.log

[Install]
WantedBy=multi-user.target
