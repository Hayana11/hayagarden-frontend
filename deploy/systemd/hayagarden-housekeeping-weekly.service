[Unit]
Description=HayaGarden weekly cache housekeeping

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/frontend
ExecStart=/usr/bin/python3.11 /opt/frontend/tools/disk_housekeeping.py --weekly --execute
NoNewPrivileges=true
PrivateDevices=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
