[Unit]
Description=Private spicy-monopoly engine
After=network.target

[Service]
Type=simple
User=frontend
Group=frontend
WorkingDirectory=/var/lib/spicy-monopoly/app
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/spicy-monopoly/.venv/bin/uvicorn monopoly_api:app --app-dir /var/lib/spicy-monopoly/app --host 127.0.0.1 --port 8069
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/spicy-monopoly

[Install]
WantedBy=multi-user.target

