<!DOCTYPE html>
<html lang="zh">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0">
<title>AI协作 · 我们家</title>
<link rel="manifest" href="/manifest.json">
<meta name="theme-color" content="#7c6a8a">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="default">
<meta name="apple-mobile-web-app-title" content="我们家">
<link rel="apple-touch-icon" href="/icon-192.png">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/tabler-icons.min.css">
<style>
*{margin:0;padding:0;box-sizing:border-box;}
:root{
  --bg:#f8f8f6;--card:#fff;--text:#2a2020;--muted:#9a8a8a;
  --primary:#7c6a8a;--primary-bg:#f0ebf4;--primary-light:rgba(124,106,138,.08);
  --amber:#d4a574;--amber-bg:#fdf4e7;
  --border:#ece6e0;--shadow:0 1px 8px rgba(40,20,20,.07);
  --red:#e05555;--green:#5a9a6a;
}
html[data-theme=dark]{
  --bg:#1a1616;--card:#241f1f;--text:#e8e2dc;--muted:#7a6a6a;
  --primary:#a08aaa;--primary-bg:#2e2838;--primary-light:rgba(160,138,170,.1);
  --amber:#d4a574;--amber-bg:#2e2418;
  --border:#3a3030;--shadow:0 1px 8px rgba(0,0,0,.3);
}
html,body{height:100%;overflow:hidden;}
body{background:var(--bg);color:var(--text);font-family:-apple-system,'PingFang SC','HarmonyOS Sans SC','Noto Sans CJK SC','Noto Sans SC',sans-serif;max-width:480px;margin:0 auto;display:flex;flex-direction:column;}

/* ── Top bar ── */
.hd{flex-shrink:0;background:var(--card);border-bottom:1px solid var(--border);position:relative;z-index:20;padding:calc(env(safe-area-inset-top, 0px) + 12px) 16px 12px;display:flex;align-items:center;justify-content:space-between;gap:10px;}
.hd-title{font-family:Georgia,'Times New Roman',serif;font-size:15px;color:var(--text);letter-spacing:.3px;flex:1;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;}
.hd-pill{font-size:11px;color:var(--muted);background:var(--primary-bg);padding:3px 10px;border-radius:20px;white-space:nowrap;flex-shrink:0;}
.hd-pill.clickable{cursor:pointer;color:var(--primary);}
.hd-pill.done{background:#e8f5ea;color:var(--green);}

/* ── Body row: sidebar + chat ── */
.body-row{flex:1;display:flex;overflow:hidden;min-height:0;}

.sidebar{width:120px;flex-shrink:0;display:flex;flex-direction:column;border-right:1px solid var(--border);background:var(--card);overflow:hidden;}
.sb-filter{display:flex;gap:4px;padding:8px 6px 4px;flex-shrink:0;}
.fchip{flex:1;font-size:9.5px;padding:4px 0;border:1px solid var(--border);border-radius:8px;background:none;color:var(--muted);cursor:pointer;font-family:inherit;}
.fchip.act{background:var(--primary-bg);border-color:var(--primary);color:var(--primary);}
.sb-list{flex:1;overflow-y:auto;padding:4px 6px;min-height:0;}
.sb-empty{text-align:center;color:var(--muted);font-size:10.5px;padding:30px 6px;line-height:1.7;}

.task-item{padding:8px;border-radius:10px;margin-bottom:5px;cursor:pointer;border-left:3px solid transparent;transition:background .15s;}
.task-item:active{background:var(--primary-light);}
.task-item.act{border-left-color:var(--primary);background:var(--primary-bg);}
.ti-top{min-height:14px;margin-bottom:3px;}
.ti-badge{font-size:9px;padding:1px 6px;border-radius:8px;font-weight:700;letter-spacing:.2px;}
.badge-P0{background:#fdeaea;color:var(--red);}
.badge-P1{background:var(--amber-bg);color:#a06030;}
.badge-P2{background:#eef0ee;color:#8a9a8a;}
.badge-ok{background:#e8f5ea;color:var(--green);}
html[data-theme=dark] .badge-P0{background:rgba(224,85,85,.15);}
html[data-theme=dark] .badge-P1{background:rgba(212,165,116,.12);}
html[data-theme=dark] .badge-P2{background:rgba(140,150,140,.12);}
html[data-theme=dark] .badge-ok{background:rgba(90,154,106,.15);}
.ti-title{font-size:11px;line-height:1.4;color:var(--text);display:-webkit-box;-webkit-line-clamp:3;-webkit-box-orient:vertical;overflow:hidden;word-break:break-all;}
.ti-count{font-size:9.5px;color:var(--muted);margin-top:4px;display:flex;align-items:center;gap:3px;}
.ti-count i{font-size:11px;}

.sb-new{flex-shrink:0;padding:8px;border-top:1px solid var(--border);}
.sb-new-btn{width:100%;padding:8px 0;border:none;border-radius:10px;background:var(--primary);color:#fff;font-size:11px;font-family:inherit;cursor:pointer;display:flex;align-items:center;justify-content:center;gap:4px;}
.sb-new-btn:active{opacity:.8;}
.sb-new-btn i{font-size:13px;}

.chat-col{flex:1;display:flex;flex-direction:column;overflow:hidden;min-width:0;}
.chat-msgs{flex:1;overflow-y:auto;padding:14px 14px 6px;min-height:0;}
.chat-msgs::-webkit-scrollbar{width:3px;}
.chat-msgs::-webkit-scrollbar-thumb{background:var(--border);border-radius:2px;}
.chat-empty{text-align:center;color:var(--muted);font-size:12.5px;padding:60px 16px;line-height:2;}

.msg-row{display:flex;margin-bottom:14px;}
.msg-row.right{justify-content:flex-end;}
.msg-row.left{justify-content:flex-start;}
.bwrap{max-width:80%;display:flex;flex-direction:column;}
.msg-row.right .bwrap{align-items:flex-end;}
.msg-row.left .bwrap{align-items:flex-start;}
.msg-author{font-size:10.5px;font-weight:600;margin-bottom:3px;display:flex;align-items:center;gap:4px;}
.msg-author i{font-size:12px;}
.msg-row.right .msg-author{flex-direction:row-reverse;}
.msg-level{font-size:9px;padding:1px 6px;border-radius:8px;font-weight:700;background:rgba(0,0,0,.08);}
.chat-bubble{padding:9px 13px;font-size:13.5px;line-height:1.6;white-space:pre-wrap;word-break:break-word;}
.chat-bubble.right{border-radius:14px 14px 4px 14px;}
.chat-bubble.left{border-radius:14px 14px 14px 4px;}
.msg-time{font-size:9.5px;color:var(--muted);margin-top:3px;padding:0 2px;}

.chat-input{flex-shrink:0;border-top:.5px solid var(--border);padding:8px 12px calc(8px + env(safe-area-inset-bottom,0px));background:var(--card);display:flex;align-items:flex-end;gap:8px;}
.chat-ta{flex:1;border:1.5px solid var(--border);border-radius:18px;padding:8px 14px;font-size:13.5px;font-family:inherit;color:var(--text);background:var(--bg);outline:none;resize:none;line-height:1.5;max-height:90px;overflow-y:auto;}
.chat-ta:focus{border-color:var(--primary);}
.chat-send{flex-shrink:0;width:36px;height:36px;border-radius:50%;border:none;background:var(--primary);color:#fff;cursor:pointer;display:flex;align-items:center;justify-content:center;font-size:16px;transition:opacity .15s,transform .15s;}
.chat-send:active{opacity:.75;transform:scale(.92);}

.panel-overlay{position:fixed;inset:0;background:rgba(0,0,0,.35);z-index:50;opacity:0;pointer-events:none;transition:opacity .25s;}
.panel-overlay.show{opacity:1;pointer-events:auto;}
.side-panel{position:fixed;top:0;right:0;height:100%;width:82%;max-width:400px;background:var(--card);z-index:51;transform:translateX(105%);transition:transform .3s cubic-bezier(.4,0,.2,1);overflow-y:auto;display:flex;flex-direction:column;box-shadow:-4px 0 24px rgba(0,0,0,.12);}
.side-panel.show{transform:translateX(0);}
.panel-hd{display:flex;align-items:center;justify-content:space-between;padding:52px 16px 12px;border-bottom:1px solid var(--border);flex-shrink:0;}
.panel-title{font-family:Georgia,serif;font-size:15px;color:var(--text);letter-spacing:.3px;}
.panel-close{width:30px;height:30px;border-radius:50%;border:none;background:var(--primary-bg);color:var(--primary);font-size:16px;cursor:pointer;display:flex;align-items:center;justify-content:center;}
.panel-body{padding:14px 16px;flex:1;}
.panel-ta{width:100%;padding:11px 13px;border-radius:12px;border:1.5px solid var(--border);background:var(--bg);font-size:13px;font-family:inherit;color:var(--text);resize:none;outline:none;min-height:100px;line-height:1.6;}
.panel-ta:focus{border-color:var(--primary);}
.panel-send{width:100%;margin-top:10px;padding:11px;border:none;border-radius:12px;background:linear-gradient(135deg,#5a8a70,#7c6a8a);color:#fff;font-size:13px;cursor:pointer;font-family:inherit;letter-spacing:.3px;transition:opacity .15s;}
.panel-send:active{opacity:.8;}
.panel-send:disabled{opacity:.5;}

.bnav{flex-shrink:0;background:rgba(255,255,255,.97);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px);border-top:.5px solid var(--border);display:flex;padding:8px 0 calc(8px + env(safe-area-inset-bottom,0px));}
html[data-theme=dark] .bnav{background:rgba(26,22,21,.97);}
.ni{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;text-decoration:none;border:none;background:none;cursor:pointer;color:#b8b0b8;font-size:10px;letter-spacing:.4px;font-family:inherit;padding:2px 0;transition:color .18s;}
.ni i{font-size:21px;}
.ni.act{color:var(--primary);}
html[data-theme=dark] .ni{color:#6a5f5f;}
</style>
</head>
<body>

<div class="hd">
  <span class="hd-title" id="hdTitle">AI协作</span>
  <span class="hd-pill" id="hdPill">…</span>
</div>

<div class="body-row">
  <div class="sidebar">
    <div class="sb-filter" id="sbFilter">
      <button class="fchip act" data-st="">全部</button>
      <button class="fchip" data-st="open">未办</button>
    </div>
    <div class="sb-list" id="sbList"></div>
    <div class="sb-new">
      <button class="sb-new-btn" onclick="openNewTask()"><i class="ti ti-plus"></i>新建任务</button>
    </div>
  </div>

  <div class="chat-col">
    <div class="chat-msgs" id="chatMsgs"><div class="chat-empty">加载中…</div></div>
    <div class="chat-input" id="chatInputArea" style="display:none">
      <textarea class="chat-ta" id="chatTa" placeholder="回复…" rows="1"
        oninput="this.style.height='auto';this.style.height=Math.min(this.scrollHeight,90)+'px'"
        onkeydown="onChatEnter(event)"></textarea>
      <button class="chat-send" onclick="sendChatMsg()"><i class="ti ti-send"></i></button>
    </div>
  </div>
</div>

<div class="panel-overlay" id="panelOverlay" onclick="closeNewTask()"></div>

<div class="side-panel" id="sidePanel">
  <div class="panel-hd">
    <span class="panel-title">发布任务 <i class="ti ti-bulb" style="color:#5a8a70;font-size:14px"></i></span>
    <button class="panel-close" onclick="closeNewTask()"><i class="ti ti-x"></i></button>
  </div>
  <div class="panel-body">
    <textarea class="panel-ta" id="panelTa" placeholder="想让蛋壳/DeepSeek看看的任务、方案或代码…"></textarea>
    <button class="panel-send" onclick="submitNewTask()">发布 ✉️</button>
  </div>
</div>

<nav class="bnav">
  <a class="ni" href="/dash"><i class="ti ti-layout-dashboard"></i><span>dash</span></a>
  <a class="ni" href="/chat"><i class="ti ti-message-2"></i><span>chat</span></a>
  <a class="ni" href="/calendar"><i class="ti ti-calendar"></i><span>calendar</span></a>
  <a class="ni" href="/read"><i class="ti ti-book"></i><span>read</span></a>
  <a class="ni" href="/board"><i class="ti ti-clipboard-list"></i><span>board</span></a>
  <a class="ni act" href="/aipanel"><i class="ti ti-robot"></i><span>ai协作</span></a>
</nav>

<script>
const AUTHOR_META = {
  hayana:          { side:'right', bg:'#7c6a8a',  color:'#fff',    border:null,      icon:'ti-heart', name:'哈娅' },
  fyodor_cc:       { side:'left',  bg:'#EEEDFE',  color:'#3C3489', border:'#AFA9EC', icon:'ti-moon',  name:'蛋壳(Claude)' },
  fyodor_deepseek: { side:'left',  bg:'#E1F5EE',  color:'#085041', border:'#5DCAA5', icon:'ti-brain', name:'DeepSeek' },
};
function authorMeta(a){ return AUTHOR_META[a] || { side:'left', bg:'#eee', color:'#666', border:null, icon:'ti-user', name:a }; }

let allTasks = [];
let activeId = null;
let activeFilter = '';

function fmtTime(s){
  if(!s) return '';
  const d = new Date(s.replace(' ','T'));
  const now = new Date();
  const diff = (now - d) / 1000;
  if(diff < 60) return '刚刚';
  if(diff < 3600) return Math.floor(diff/60) + '分钟前';
  if(diff < 86400) return Math.floor(diff/3600) + '小时前';
  const mo = d.getMonth()+1, dd = d.getDate();
  const h = String(d.getHours()).padStart(2,'0'), m = String(d.getMinutes()).padStart(2,'0');
  return `${mo}-${dd} ${h}:${m}`;
}

function escHtml(s){ return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;'); }

function taskCount(t){ return 1 + (t.replies ? t.replies.length : 0); }
function taskBadge(t){
  if(t.status === 'done') return '<span class="ti-badge badge-ok">ok</span>';
  if(t.level) return `<span class="ti-badge badge-${t.level}">${t.level}</span>`;
  return '';
}

function renderSidebar(){
  const wrap = document.getElementById('sbList');
  let items = allTasks;
  if(activeFilter) items = items.filter(t=>t.status===activeFilter);
  if(!items.length){
    wrap.innerHTML = '<div class="sb-empty">还没有任务</div>';
    return;
  }
  wrap.innerHTML = items.map(t=>`
    <div class="task-item${t.id===activeId?' act':''}" onclick="selectTask(${t.id})">
      <div class="ti-top">${taskBadge(t)}</div>
      <div class="ti-title">${escHtml(t.content)}</div>
      <div class="ti-count"><i class="ti ti-message-circle"></i>${taskCount(t)}</div>
    </div>
  `).join('');
}

function renderTopBar(){
  const titleEl = document.getElementById('hdTitle');
  const pillEl = document.getElementById('hdPill');
  const task = allTasks.find(t=>t.id===activeId);
  if(task){
    const oneLine = task.content.replace(/\n/g,' ');
    titleEl.textContent = oneLine.length > 18 ? oneLine.slice(0,18) + '…' : oneLine;
    pillEl.classList.add('clickable');
    pillEl.classList.toggle('done', task.status === 'done');
    pillEl.textContent = task.status === 'done' ? '已完成' : '进行中';
    pillEl.onclick = () => toggleStatus(task.id, task.status === 'done' ? 'open' : 'done');
  } else {
    titleEl.textContent = 'AI协作';
    pillEl.classList.remove('clickable','done');
    pillEl.onclick = null;
    const openCount = allTasks.filter(t=>t.status==='open').length;
    pillEl.textContent = openCount > 0 ? `${openCount} 进行中` : '全部完成';
  }
}

function buildBubble(msg){
  const am = authorMeta(msg.author);
  const levelBadge = msg.level ? `<span class="msg-level">${msg.level}</span>` : '';
  let style = `background:${am.bg};color:${am.color}`;
  if(am.border) style += `;border:0.5px solid ${am.border}`;
  return `<div class="msg-row ${am.side}">
      <div class="bwrap">
        <div class="msg-author" style="color:${am.side==='right'?am.bg:am.color}"><i class="ti ${am.icon}"></i>${escHtml(am.name)}${levelBadge}</div>
        <div class="chat-bubble ${am.side}" style="${style}">${escHtml(msg.content)}</div>
        <div class="msg-time">${fmtTime(msg.created_at)}</div>
      </div>
    </div>`;
}

function renderChat(){
  const c = document.getElementById('chatMsgs');
  const task = allTasks.find(t=>t.id===activeId);
  if(!task){
    c.innerHTML = '<div class="chat-empty">选一个任务，或新建一个 ✦</div>';
    return;
  }
  const msgs = [
    { author: task.author, content: task.content, level: null, created_at: task.created_at },
    ...task.replies
  ];
  c.innerHTML = msgs.map(buildBubble).join('');
}

function scrollChatBottom(){
  const c = document.getElementById('chatMsgs');
  c.scrollTop = c.scrollHeight;
}

function selectTask(id){
  activeId = id;
  renderSidebar();
  renderTopBar();
  renderChat();
  document.getElementById('chatInputArea').style.display = '';
  scrollChatBottom();
}

async function loadTasks(isInit){
  try{
    const r = await fetch('/api/aipanel');
    const data = await r.json();
    allTasks = data;
    if(isInit && activeId === null && allTasks.length) activeId = allTasks[0].id;
    if(activeId !== null && !allTasks.some(t=>t.id===activeId)) activeId = allTasks.length ? allTasks[0].id : null;

    const c = document.getElementById('chatMsgs');
    const wasAtBottom = c.scrollHeight - c.scrollTop - c.clientHeight < 80;

    renderSidebar();
    renderTopBar();
    renderChat();
    document.getElementById('chatInputArea').style.display = activeId !== null ? '' : 'none';
    if(isInit || wasAtBottom) scrollChatBottom();
  }catch(e){
    if(isInit) document.getElementById('chatMsgs').innerHTML = '<div class="chat-empty">加载失败</div>';
  }
}

function toggleStatus(id, newStatus){
  fetch(`/api/aipanel/${id}/status`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({status:newStatus})})
    .then(()=>loadTasks(false));
}

function onChatEnter(e){
  if(e.key === 'Enter' && !e.shiftKey){ e.preventDefault(); sendChatMsg(); }
}

async function sendChatMsg(){
  if(activeId === null) return;
  const ta = document.getElementById('chatTa');
  const content = (ta.value || '').trim();
  if(!content) return;
  ta.value = ''; ta.style.height = 'auto';
  await fetch(`/api/aipanel/${activeId}/reply`,{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({author:'hayana',content})});
  await loadTasks(false);
  scrollChatBottom();
}

document.getElementById('sbFilter').addEventListener('click', e=>{
  const btn = e.target.closest('.fchip');
  if(!btn) return;
  document.querySelectorAll('.fchip').forEach(b=>b.classList.remove('act'));
  btn.classList.add('act');
  activeFilter = btn.dataset.st;
  renderSidebar();
});

if(window.matchMedia('(prefers-color-scheme:dark)').matches)
  document.documentElement.setAttribute('data-theme','dark');

function openNewTask(){
  document.getElementById('panelOverlay').classList.add('show');
  document.getElementById('sidePanel').classList.add('show');
}
function closeNewTask(){
  document.getElementById('panelOverlay').classList.remove('show');
  document.getElementById('sidePanel').classList.remove('show');
}

async function submitNewTask(){
  const ta = document.getElementById('panelTa');
  const content = (ta.value || '').trim();
  if(!content) return;
  const sendBtn = document.querySelector('.panel-send');
  sendBtn.disabled = true;
  try{
    const r = await fetch('/api/aipanel',{method:'POST',headers:{'Content-Type':'application/json'},
      body:JSON.stringify({author:'hayana', content})});
    const d = await r.json();
    ta.value = '';
    closeNewTask();
    await loadTasks(false);
    if(d && d.id) selectTask(d.id);
  } finally {
    sendBtn.disabled = false;
  }
}

if('serviceWorker' in navigator){navigator.serviceWorker.register('/sw.js').then(function(r){r.update();}).catch(console.error);}
loadTasks(true);
setInterval(()=>loadTasks(false), 5000);
</script>
</body>
</html>
